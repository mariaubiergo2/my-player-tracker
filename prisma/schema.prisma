datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PLAYER
  GOAL_KEEPER
  TRAINER
  ADMIN
}

enum TrainerSpecialty {
  VIDEO_ANALYSIS
  PHYSICAL_PREP
  NUTRITION
}


enum MatchType {
  FRIENDLY
  LEAGUE
  CUP
  TRAINING
}

model User {
  id        String   @id @default(cuid())
  name      String
  surname   String
  email     String   @unique
  password  String
  role      UserRole @default(PLAYER)
  trainerSpecialty TrainerSpecialty? @map("trainer_specialty")

  phone     String?
  avatarUrl String?
  birthDate DateTime?
  emailVerified Boolean @default(false) @map("email_verified")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  playerMatches  Match[] @relation("PlayerMatches")
  trainerMatches Match[] @relation("TrainerMatches")

  trainers  User[]  @relation("TrainerPlayers")
  players   User[]  @relation("TrainerPlayers")
  feedbackMessages MatchFeedbackMessage[]
  notifications    Notification[]         @relation("UserNotifications")
  trainerQuestionnaires Questionnaire[]           @relation("TrainerQuestionnaires")
  playerAssignments     QuestionnaireAssignment[] @relation("PlayerAssignments")
  playerObjectivesReceived PlayerObjectives[] @relation("PlayerObjectives")
  playerObjectivesDefined  PlayerObjectives[] @relation("TrainerDefinedObjectives")
  verificationCodes EmailVerificationCode[]
  objectivesRequestsAsPlayer  ObjectivesRequest[] @relation("ObjectivesRequestsAsPlayer")
  objectivesRequestsAsTrainer ObjectivesRequest[] @relation("ObjectivesRequestsAsTrainer")

  trainerExercises         Exercise[]               @relation("TrainerExercises")
  trainerPlans             TrainingPlan[]           @relation("TrainerPlans")
  playerPlanAssignments   TrainingPlanAssignment[] @relation("PlayerPlanAssignments")
  playerSessionCompletions SessionCompletion[]     @relation("PlayerSessionCompletions")
  playerTrainingFeedback  TrainingFeedback[]       @relation("PlayerTrainingFeedback")

  @@map("users")
}

model EmailVerificationCode {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash      String    @map("code_hash")
  attempts      Int       @default(0)
  expiresAt     DateTime  @map("expires_at")
  consumedAt    DateTime? @map("consumed_at")
  invalidatedAt DateTime? @map("invalidated_at")

  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("email_verification_codes")
}

model Match {
  id          String @id @default(cuid())

  name        String
  description String?
  location    String?
  isHome      Boolean? @map("is_home")

  // --- Technical player file ---
  matchUrl    String?  @map("match_url")
  kitColor    String?  @map("kit_color")
  shirtNumber String?  @map("shirt_number")
  position    String?
  minutesPlayed String? @map("minutes_played")

  // --- Date and schedule ---
  date      DateTime
  startTime String?
  endTime   String?

  // --- Competition ---
  opponent        String?
  category        String?
  leaguePosition  String? @map("league_position")
  matchType       MatchType?
  competitionType String? @map("competition_type")

  playerId  String @map("player_id")
  trainerId String? @map("trainer_id")
  teamId    String? @map("team_id")

  player  User @relation("PlayerMatches", fields: [playerId], references: [id], onDelete: Cascade)
  trainer User? @relation("TrainerMatches", fields: [trainerId], references: [id], onDelete: Cascade)

  comment          String?
  trainerFeedback  String? @map("trainer_feedback")
  playerReflection String? @map("player_reflection")

  mark        Int?
  intensity   Int?
  attitude    Int?
  performance Int?

  goals         Int? @default(0)
  assists       Int? @default(0)

  strengths        String[]
  weaknesses       String[]
  improvementAreas String[] @map("improvement_areas")

  offensiveActionsOwnHalf      String? @map("offensive_actions_own_half")
  offensiveActionsOpponentHalf String? @map("offensive_actions_opponent_half")
  defensiveActionsOwnHalf      String? @map("defensive_actions_own_half")
  defensiveActionsOpponentHalf String? @map("defensive_actions_opponent_half")

  isReviewed Boolean   @default(false) @map("is_reviewed")
  reviewedAt DateTime? @map("reviewed_at")

  video Video?
  feedbackMessages MatchFeedbackMessage[]
  notifications    Notification[]         @relation("MatchNotifications")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("matches")
}

model Video {
  id            String   @id @default(cuid())
  matchId       String   @unique @map("match_id")
  match         Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  muxAssetId    String?  @map("mux_asset_id")
  muxPlaybackId String?  @map("mux_playback_id")
  muxUploadId   String?  @map("mux_upload_id")
  status        String   @default("uploading") // uploading, processing, ready, errored
  duration      Float?
  title         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("videos")
}

model MatchFeedbackMessage {
  id         String   @id @default(cuid())
  matchId    String   @map("match_id")
  authorId   String   @map("author_id")
  authorRole String   @map("author_role")
  content    String
  createdAt  DateTime @default(now()) @map("created_at")

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("match_feedback_messages")
}

enum QuestionnaireStatus {
  DRAFT
  DEFINED
  SEND
}

enum AssignmentStatus {
  SENT
  RECLAIMED
  COMPLETED
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN
}

model Questionnaire {
  id          String              @id @default(cuid())
  title       String
  description String?
  status      QuestionnaireStatus @default(DRAFT)
  type        QuestionnaireType   @default(ANALYSIS_VIDEO)
  trainerId   String              @map("trainer_id")
  trainer     User                @relation("TrainerQuestionnaires", fields: [trainerId], references: [id], onDelete: Cascade)
  questions   Question[]
  assignments QuestionnaireAssignment[]
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  @@index([trainerId])
  @@map("questionnaires")
}

model Question {
  id              String        @id @default(cuid())
  questionnaireId String        @map("questionnaire_id")
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  text            String
  type            QuestionType
  options         String[]
  order           Int
  answers         Answer[]
  @@index([questionnaireId])
  @@map("questions")
}

model QuestionnaireAssignment {
  id              String            @id @default(cuid())
  questionnaireId String            @map("questionnaire_id")
  questionnaire   Questionnaire     @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  playerId        String            @map("player_id")
  player          User              @relation("PlayerAssignments", fields: [playerId], references: [id], onDelete: Cascade)
  status          AssignmentStatus  @default(SENT)
  answers         Answer[]
  notifications   Notification[]    @relation("AssignmentNotifications")
  sentAt          DateTime          @default(now()) @map("sent_at")
  reclaimedAt     DateTime?         @map("reclaimed_at")
  respondedAt     DateTime?         @map("responded_at")
  @@index([playerId, status])
  @@index([questionnaireId])
  @@map("questionnaire_assignments")
}

model Answer {
  id           String                  @id @default(cuid())
  assignmentId String                  @map("assignment_id")
  assignment   QuestionnaireAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  questionId   String                  @map("question_id")
  question     Question                @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value        String
  @@unique([assignmentId, questionId])
  @@map("answers")
}

enum NotificationType {
  MATCH_CREATED
  MATCH_UPDATED
  MATCH_UPDATED_BY_TRAINER
  FEEDBACK_MESSAGE_FROM_PLAYER
  FEEDBACK_MESSAGE_FROM_TRAINER
  QUESTIONNAIRE_SENT
  QUESTIONNAIRE_RESPONDED
  QUESTIONNAIRE_RECLAIMED
  OBJECTIVES_REQUEST_CREATED
  OBJECTIVES_REQUEST_REPLIED
  TRAINING_PLAN_SENT
  SESSION_FEEDBACK_RECEIVED
  PLAN_FEEDBACK_RECEIVED
  TRAINING_PLAN_UPDATED
}

model Notification {
  id            String                   @id @default(cuid())
  recipientId   String                   @map("recipient_id")
  type          NotificationType
  matchId       String?                  @map("match_id")
  assignmentId  String?                  @map("assignment_id")
  objectivesRequestId String?            @map("objectives_request_id")
  trainingPlanAssignmentId String?       @map("training_plan_assignment_id")
  trainingFeedbackId String?             @map("training_feedback_id")
  isRead        Boolean                  @default(false) @map("is_read")
  createdAt     DateTime                 @default(now()) @map("created_at")

  recipient     User                     @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  match         Match?                   @relation("MatchNotifications", fields: [matchId], references: [id], onDelete: Cascade)
  assignment    QuestionnaireAssignment? @relation("AssignmentNotifications", fields: [assignmentId], references: [id], onDelete: Cascade)
  objectivesRequest ObjectivesRequest?   @relation("ObjectivesRequestNotifications", fields: [objectivesRequestId], references: [id], onDelete: Cascade)
  trainingPlanAssignment TrainingPlanAssignment? @relation("NotificationTrainingPlanAssignment", fields: [trainingPlanAssignmentId], references: [id], onDelete: Cascade)
  trainingFeedback TrainingFeedback? @relation("NotificationTrainingFeedback", fields: [trainingFeedbackId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt(sort: Desc)])
  @@index([objectivesRequestId])
  @@map("notifications")
}

model PlayerObjectives {
  id            String    @id @default(cuid())

  playerId      String    @map("player_id")
  player        User      @relation("PlayerObjectives", fields: [playerId], references: [id], onDelete: Cascade)

  trainerId     String    @map("trainer_id")
  trainer       User      @relation("TrainerDefinedObjectives", fields: [trainerId], references: [id], onDelete: Cascade)

  summary       String              // breve texto libre redactado por el trainer
  items         String[]            // lista de objetivos individuales, en orden
  category      QuestionnaireType   @default(ANALYSIS_VIDEO)

  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")   // null = objetivo actualmente activo

  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([playerId, effectiveFrom])
  @@index([playerId, effectiveTo])
  @@map("player_objectives")
}

enum ObjectivesRequestStatus {
  PENDING
  ACKNOWLEDGED   // el trainer ha respondido con un mensaje/icono ("lo estoy mirando")
  RESOLVED       // el trainer ha definido/redefinido objetivos como consecuencia (opcional, ligar a PlayerObjectives si se detecta)
}

model ObjectivesRequest {
  id          String   @id @default(cuid())
  playerId    String   @map("player_id")
  trainerId   String   @map("trainer_id")   // a qué entrenador concreto va dirigida
  reason      String                        // descripción corta escrita por el jugador
  status      ObjectivesRequestStatus @default(PENDING)
  trainerReply String? @map("trainer_reply") // mensaje/icono predefinido del trainer
  repliedAt   DateTime? @map("replied_at")
  createdAt   DateTime @default(now()) @map("created_at")
  type        QuestionnaireType       @default(ANALYSIS_VIDEO)

  player      User @relation("ObjectivesRequestsAsPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  trainer     User @relation("ObjectivesRequestsAsTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  notifications Notification[] @relation("ObjectivesRequestNotifications")

  @@index([playerId, createdAt(sort: Desc)])
  @@index([trainerId, status, createdAt(sort: Desc)])
  @@map("objectives_requests")
}

enum PlanStatus {
  DRAFT
  SENT
}

enum ExerciseMediaType {
  IMAGE
  VIDEO_LINK
}

enum RecurrenceDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum QuestionnaireType {
  ANALYSIS_VIDEO
  PHYSICAL
  NUTRITION
}

model Exercise {
  id          String             @id @default(cuid())
  trainerId   String             @map("trainer_id")
  trainer     User               @relation("TrainerExercises", fields: [trainerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  repetitions String
  mediaType   ExerciseMediaType? @map("media_type")
  imageUrl    String?            @map("image_url")
  videoUrl    String?            @map("video_url")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  sessionExercises SessionExercise[]

  @@index([trainerId])
  @@map("exercises")
}

model TrainingPlan {
  id          String     @id @default(cuid())
  trainerId   String     @map("trainer_id")
  trainer     User       @relation("TrainerPlans", fields: [trainerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      PlanStatus @default(DRAFT)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  sessions    TrainingSession[]
  assignments TrainingPlanAssignment[]

  @@map("training_plans")
}

model TrainingSession {
  id             String          @id @default(cuid())
  trainingPlanId String          @map("training_plan_id")
  trainingPlan   TrainingPlan    @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  title          String
  order          Int
  recurrenceDays RecurrenceDay[] @map("recurrence_days")
  startDate      DateTime        @map("start_date")
  endDate        DateTime        @map("end_date")

  exercises   SessionExercise[]
  completions SessionCompletion[]
  feedback    TrainingFeedback[]

  @@index([trainingPlanId])
  @@map("training_sessions")
}

model SessionExercise {
  id                  String          @id @default(cuid())
  sessionId           String          @map("session_id")
  session             TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId          String          @map("exercise_id")
  exercise            Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order               Int
  repetitionsOverride String?         @map("repetitions_override")

  @@unique([sessionId, exerciseId])
  @@map("session_exercises")
}

model TrainingPlanAssignment {
  id             String       @id @default(cuid())
  trainingPlanId String       @map("training_plan_id")
  trainingPlan   TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  playerId       String       @map("player_id")
  player         User         @relation("PlayerPlanAssignments", fields: [playerId], references: [id], onDelete: Cascade)
  sentAt         DateTime     @default(now()) @map("sent_at")

  planFeedback TrainingFeedback[]
  notifications Notification[] @relation("NotificationTrainingPlanAssignment")

  @@unique([trainingPlanId, playerId])
  @@index([playerId])
  @@map("training_plan_assignments")
}

model SessionCompletion {
  id            String          @id @default(cuid())
  sessionId     String          @map("session_id")
  session       TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId      String          @map("player_id")
  player         User            @relation("PlayerSessionCompletions", fields: [playerId], references: [id], onDelete: Cascade)
  scheduledDate DateTime        @map("scheduled_date")
  completedAt   DateTime        @default(now()) @map("completed_at")

  @@unique([sessionId, playerId, scheduledDate])
  @@map("session_completions")
}

model TrainingFeedback {
  id           String                  @id @default(cuid())
  playerId     String                  @map("player_id")
  player       User                    @relation("PlayerTrainingFeedback", fields: [playerId], references: [id], onDelete: Cascade)
  sessionId    String?                 @map("session_id")
  session      TrainingSession?        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignmentId String?                 @map("assignment_id")
  assignment   TrainingPlanAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  comment      String?
  videoUrl     String?                 @map("video_url")
  isReviewed   Boolean                 @default(false) @map("is_reviewed")
  reviewedAt   DateTime?               @map("reviewed_at")
  createdAt    DateTime                @default(now()) @map("created_at")

  notifications Notification[] @relation("NotificationTrainingFeedback")

  @@index([sessionId])
  @@index([assignmentId])
  @@map("training_feedbacks")
}